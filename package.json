{
  "name": "copyleaks",
  "version": "6.0.0",
  "description": "The official Copyleaks Node.js SDK.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./dist/models/constants": {
      "import": "./dist/esm/models/constants/index.js",
      "require": "./dist/models/constants/index.js"
    },
    "./dist/models/exceptions": {
      "import": "./dist/esm/models/exceptions/index.js",
      "require": "./dist/models/exceptions/index.js"
    },
    "./dist/models/exports": {
      "import": "./dist/esm/models/exports/index.js",
      "require": "./dist/models/exports/index.js"
    },
    "./dist/models/request": {
      "import": "./dist/esm/models/request/index.js",
      "require": "./dist/models/request/index.js"
    },
    "./dist/models/response": {
      "import": "./dist/esm/models/response/index.js",
      "require": "./dist/models/response/index.js"
    },
    "./dist/models/submissions": {
      "import": "./dist/esm/models/submissions/index.js",
      "require": "./dist/models/submissions/index.js"
    },
    "./dist/models/submissions/properties": {
      "import": "./dist/esm/models/submissions/properties/index.js",
      "require": "./dist/models/submissions/properties/index.js"
    },
    "./dist/utils": {
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "copyleaks",
    "ai-text-detection",
    "ai-image-detection",
    "plagiarism-checker",
    "grammar-checker",
    "text-moderation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Copyleaks/NodeJS-Plagiarism-Checker.git"
  },
  "scripts": {
    "build": "rimraf dist && npm run build:cjs && npm run build:esm",
    "prepare": "npm run build",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }, null, 2) + '\\n')\"",
    "build:watch": "tsc --watch",
    "lint": "tslint --project \"./tsconfig.json\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:types": "npm run build && tsc -p test-types/tsconfig.json --noEmit --strict",
    "docs": "rimraf docs && typedoc --out docs src",
    "gh-pages": "npm run docs && gh-pages -d docs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "rimraf": "^3.0.2"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^14.14.20",
    "gh-pages": "^3.1.0",
    "tslint": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
